---
const smallProducts = [
  {
    name: 'True Loan',
    url: 'https://trueloan.app',
    domain: 'trueloan.app',
    status: 'Live',
    statusKind: 'live',
    tagline: 'The mortgage calculator that’s on your side.',
    desc: 'An honest, intelligent Australian mortgage calculator. True repayment maths — no “13th payment” tricks — offset accounts, stamp duty for every state and territory, and an AI assistant grounded in your actual numbers.',
    tileClass: 'tile-trueloan',
    mark: 'true loan',
  },
  {
    name: 'Liv',
    url: 'https://liv4all.com',
    domain: 'liv4all.com',
    status: 'Closed to new sign-ups · winding down',
    statusKind: 'sunset',
    tagline: 'An AI chief of staff, on Telegram.',
    desc: 'A persistent AI agent that acted on your behalf — managing calendars, triaging email, making bookings. Liv is being retired; much of what we learned building it went straight into Hakken.',
    tileClass: 'tile-liv',
    mark: 'liv.',
  },
];
---

<section id="products" class="products">
  <div class="wrap">
    <p class="eyebrow">Products</p>
    <h2 class="section-title">Built here.</h2>

    <a class="feature" href="https://hakken.me">
      <div class="feature-copy">
        <div class="status live">New · web, with iOS &amp; Android on the way</div>
        <h3>Hakken</h3>
        <p class="tagline">Learning, built around you.</p>
        <p class="desc">
          Hakken interviews you about what you want to learn — your goals, your
          level, your schedule — then generates a course tailored to you and
          adapts it as you go. Lessons, checkpoints and a voice interview that
          actually listens.
        </p>
        <span class="link">hakken.me <span class="chev">›</span></span>
      </div>
      <div class="feature-tile" aria-hidden="true">
        <div class="jp">発見</div>
        <div class="wordmark">hakken</div>
        <div class="jp-caption">hakken — “discovery”</div>
      </div>
    </a>

    <div class="pair">
      {
        smallProducts.map((p) => (
          <a class="card" href={p.url}>
            <div class={`tile ${p.tileClass}`} aria-hidden="true">
              <span class="tile-mark">{p.mark}</span>
            </div>
            <div class="card-copy">
              <div class={`status ${p.statusKind}`}>{p.status}</div>
              <h3>{p.name}</h3>
              <p class="tagline">{p.tagline}</p>
              <p class="desc">{p.desc}</p>
              <span class="link">
                {p.domain} <span class="chev">›</span>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .products {
    padding: 48px 0 32px;
  }

  .section-title {
    margin-bottom: 40px;
  }

  /* ---- shared card language ---- */
  .feature,
  .card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--card);
    border-radius: 24px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .feature:hover,
  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--card-hover-shadow);
  }

  .status {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .status.live {
    color: #1d9b3f;
  }

  @media (prefers-color-scheme: dark) {
    .status.live {
      color: #30d158;
    }
  }

  .status.sunset {
    color: var(--ink-faint);
  }

  h3 {
    font-size: 34px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin: 0 0 6px;
  }

  .tagline {
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin: 0 0 14px;
  }

  .desc {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 0 0 22px;
    text-wrap: pretty;
  }

  .link {
    font-size: 15px;
    font-weight: 500;
    color: var(--link);
  }

  .chev {
    display: inline-block;
    transition: transform 0.2s;
  }

  .feature:hover .chev,
  .card:hover .chev {
    transform: translateX(3px);
  }

  /* ---- featured Hakken card ---- */
  .feature {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
  }

  .feature-copy {
    padding: 48px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .feature-copy h3 {
    font-size: 44px;
  }

  .feature-tile {
    position: relative;
    min-height: 380px;
    background: linear-gradient(135deg, #0f2036 0%, #1f3a5f 55%, #3f6798 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #fff;
  }

  .jp {
    font-size: 15px;
    letter-spacing: 0.5em;
    margin-left: 0.5em; /* optically recenter the tracked glyphs */
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 12px;
  }

  .wordmark {
    font-size: 64px;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .jp-caption {
    position: absolute;
    bottom: 24px;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.45);
    letter-spacing: 0.04em;
  }

  /* ---- small product cards ---- */
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 24px;
  }

  .tile {
    height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tile-mark {
    font-size: 36px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .tile-trueloan {
    background: linear-gradient(135deg, #0c3b2e 0%, #156353 60%, #2e8b6f 100%);
  }

  .tile-liv {
    background: linear-gradient(135deg, #1c1430 0%, #3b2a63 60%, #6b4fae 100%);
  }

  .card .tile-liv .tile-mark,
  .card .tile-trueloan .tile-mark {
    opacity: 0.95;
  }

  .card-copy {
    padding: 32px;
  }

  .card-copy h3 {
    font-size: 26px;
  }

  .card-copy .tagline {
    font-size: 17px;
  }

  @media (max-width: 820px) {
    .feature {
      grid-template-columns: 1fr;
    }

    .feature-tile {
      order: -1;
      min-height: 240px;
    }

    .feature-copy {
      padding: 32px 28px 36px;
    }

    .feature-copy h3 {
      font-size: 36px;
    }

    .wordmark {
      font-size: 48px;
    }

    .pair {
      grid-template-columns: 1fr;
    }
  }
</style>
