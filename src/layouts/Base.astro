---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Eigenstack — a small software studio in Sydney',
  description = 'Eigenstack Pty Ltd is an independent software studio in Sydney, Australia — the company behind Hakken, True Loan and Liv.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="canonical" href="https://eigenstack.co/" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://eigenstack.co/" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
