---
const pillars = ['Engineering leadership', 'AI adoption', 'Agentic software'];
---

<section id="advisory" class="advisory">
  <div class="wrap inner">
    <div>
      <p class="eyebrow">Advisory</p>
      <h2 class="section-title">Available for the occasional good problem.</h2>
      <p class="body">
        One client at a time, generally remote, generally a day or two each
        month. If your work overlaps with the topics on the right, get in
        touch.
      </p>
      <a class="email" href="mailto:hello@eigenstack.co">hello@eigenstack.co ›</a>
    </div>

    <ul class="pillars">
      {pillars.map((p) => <li>{p}</li>)}
    </ul>
  </div>
</section>

<style>
  .advisory {
    padding: 64px 0;
  }

  .inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 64px;
    padding-top: 64px;
    padding-bottom: 0;
    border-top: 1px solid var(--hairline);
  }

  .body {
    margin: 20px 0 0;
    max-width: 460px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .email {
    display: inline-block;
    margin-top: 24px;
    font-size: 15px;
    font-weight: 500;
    color: var(--link);
    text-decoration: none;
  }

  .email:hover {
    text-decoration: underline;
  }

  .pillars {
    list-style: none;
    margin: 0;
    padding: 0;
    align-self: center;
  }

  .pillars li {
    padding: 18px 0;
    font-size: 21px;
    font-weight: 500;
    letter-spacing: -0.01em;
    border-bottom: 1px solid var(--hairline);
  }

  .pillars li:first-child {
    border-top: 1px solid var(--hairline);
  }

  @media (max-width: 820px) {
    .inner {
      grid-template-columns: 1fr;
      gap: 36px;
      padding-top: 48px;
    }

    .pillars li {
      font-size: 18px;
      padding: 14px 0;
    }
  }
</style>
