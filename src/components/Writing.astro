---
const posts = [
  {
    n: '#42',
    d: 'Apr 2026',
    t: 'There Is No Best Move',
    href: 'https://leonardoborges.substack.com/p/42-there-is-no-best-move',
  },
  {
    n: '#40',
    d: 'Mar 2026',
    t: 'Why Guardrails Don’t Work',
    href: 'https://leonardoborges.substack.com/p/tltd-40-why-guardrails-dont-work',
  },
  {
    n: '#39',
    d: 'Mar 2026',
    t: 'Voice AI: The Next Platform Shift',
    href: 'https://leonardoborges.substack.com/p/tltd-39-voice-ai-the-next-platform',
  },
];
---

<section id="writing" class="writing">
  <div class="wrap">
    <div class="head">
      <div>
        <p class="eyebrow">Writing</p>
        <h2 class="section-title">From The LeadTech Diet.</h2>
      </div>
      <a class="all" href="https://leonardoborges.substack.com">All issues ›</a>
    </div>

    <div class="list">
      {
        posts.map((p) => (
          <a class="row" href={p.href}>
            <span class="num">{p.n}</span>
            <span class="date">{p.d}</span>
            <span class="title">{p.t}</span>
            <span class="chev">›</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .writing {
    padding: 64px 0 96px;
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    margin-bottom: 32px;
  }

  .all {
    font-size: 15px;
    font-weight: 500;
    color: var(--link);
    text-decoration: none;
    white-space: nowrap;
  }

  .all:hover {
    text-decoration: underline;
  }

  .row {
    display: grid;
    grid-template-columns: 56px 96px 1fr 20px;
    gap: 20px;
    align-items: baseline;
    padding: 20px 0;
    border-top: 1px solid var(--hairline);
    text-decoration: none;
    color: inherit;
  }

  .row:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .num,
  .date {
    font-size: 13px;
    color: var(--ink-faint);
  }

  .title {
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.01em;
    transition: color 0.15s;
  }

  .row:hover .title {
    color: var(--link);
  }

  .chev {
    color: var(--ink-faint);
    text-align: right;
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: 44px 1fr 16px;
      gap: 12px;
    }

    .date {
      display: none;
    }

    .title {
      font-size: 17px;
    }
  }
</style>
