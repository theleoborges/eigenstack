---
import EigenMark from './EigenMark.astro';
---

<footer id="contact" class="footer">
  <div class="wrap">
    <div class="grid">
      <div class="who">
        <EigenMark size={18} color="var(--ink)" />
        <div class="legal-name">Eigenstack Pty Ltd</div>
        <div class="meta">ABN 41 697 589 969</div>
        <div class="meta">Sydney, Australia</div>
      </div>

      <div>
        <div class="col-head">Products</div>
        <div><a href="https://hakken.me">hakken.me</a></div>
        <div><a href="https://trueloan.app">trueloan.app</a></div>
        <div><a href="https://liv4all.com">liv4all.com</a></div>
      </div>

      <div>
        <div class="col-head">Contact</div>
        <div><a href="mailto:hello@eigenstack.co">hello@eigenstack.co</a></div>
        <div><a href="https://www.linkedin.com/in/theleoborges/">LinkedIn</a></div>
        <div><a href="https://github.com/theleoborges/">GitHub</a></div>
      </div>

      <div>
        <div class="col-head">Elsewhere</div>
        <div><a href="https://leonardoborges.com">leonardoborges.com</a></div>
        <div><a href="https://leonardoborges.substack.com">The Steel Thread</a></div>
      </div>
    </div>

    <div class="bottom">
      <span>© 2026 Eigenstack Pty Ltd. All rights reserved.</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--hairline);
    background: var(--bg-subtle);
    padding: 48px 0 32px;
    font-size: 13px;
    color: var(--ink-soft);
  }

  .grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 32px;
  }

  .footer a {
    color: inherit;
    text-decoration: none;
    line-height: 1.9;
  }

  .footer a:hover {
    color: var(--ink);
  }

  .legal-name {
    margin-top: 12px;
    font-weight: 600;
    color: var(--ink);
  }

  .meta {
    line-height: 1.7;
  }

  .col-head {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 8px;
  }

  .bottom {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--hairline);
    font-size: 12px;
    color: var(--ink-faint);
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }
  }
</style>
